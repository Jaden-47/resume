---
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');
posts.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.date.localeCompare(a.data.date);
});
---
<section id="section-06" class="blog">
  <div class="blog-inner">
    <div class="section-label" data-i18n="blog.label">06 — 文章 & 分享</div>

    <div class="blog-columns">
      {posts.map((post, i) => (
        <>
          <div class="blog-column">
            <div class={`blog-illustration blog-illus-${post.slug}`} aria-hidden="true"></div>
            <div class="blog-meta">
              <span class="blog-category mono" data-zh={post.data.category} data-en={post.data.categoryEn}>
                {post.data.category}
              </span>
            </div>
            <h3 class="blog-title">
              <span data-zh={post.data.title} data-en={post.data.titleEn}>
                {post.data.title}
              </span>
            </h3>
            <div class="blog-date-read mono">{post.data.date} · {post.data.readTime} read</div>
            <p class="blog-excerpt">
              <span data-zh={post.data.excerpt} data-en={post.data.excerptEn}>
                {post.data.excerpt}
              </span>
            </p>
          </div>
          {i < posts.length - 1 && <div class="blog-divider-col"></div>}
        </>
      ))}
    </div>

    <div class="blog-more">
      <div class="blog-more-line"></div>
      <span data-i18n="blog.more">更多文章 →</span>
    </div>
  </div>
</section>

<style>
.blog {
  background: var(--cream);
  padding: 80px 40px;
  min-height: 80vh;
}

.blog-inner {
  max-width: 1000px;
  margin: 0 auto;
}

.blog-inner .section-label { margin-bottom: 48px; }

.blog-columns {
  display: grid;
  grid-template-columns: 1fr 1px 1fr 1px 1fr;
  gap: 0;
}

.blog-divider-col { background: #d9d3c8; }

.blog-column { padding: 0 32px; }

.blog-illustration {
  height: 100px;
  margin-bottom: 16px;
  background: var(--dark);
}

.blog-illus-agent-migration {
  background: linear-gradient(135deg, var(--dark) 50%, var(--gold) 50%);
}

.blog-illus-rustui-engine {
  background: var(--dark);
}

.blog-illus-dds-optimization {
  background: var(--dark);
}

.blog-meta { margin-bottom: 8px; }

.blog-category {
  font-size: 9px;
  letter-spacing: 3px;
  color: var(--gold);
}

.blog-title {
  font-family: var(--font-display);
  font-size: clamp(14px, 1.8vw, 18px);
  font-weight: 700;
  color: var(--dark);
  line-height: 1.4;
  margin-bottom: 8px;
}

.blog-date-read {
  font-size: 9px;
  letter-spacing: 1px;
  color: var(--gray-3);
  margin-bottom: 12px;
}

.blog-excerpt {
  font-family: var(--font-body);
  font-size: 12px;
  color: var(--gray-1);
  line-height: 1.8;
}

.blog-more {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-top: 48px;
  justify-content: flex-end;
}

.blog-more-line {
  flex: 1;
  height: 1px;
  background: var(--dark);
  max-width: 80px;
}

.blog-more span {
  font-family: var(--font-display);
  font-size: 12px;
  letter-spacing: 2px;
  color: var(--dark);
}

@media (max-width: 768px) {
  .blog-columns { grid-template-columns: 1fr; }
  .blog-divider-col { display: none; }
  .blog-column { padding: 20px 0; border-bottom: 1px solid #d9d3c8; }
}
</style>
