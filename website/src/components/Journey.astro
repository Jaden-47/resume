---
const nodes = [
  { year: '2019', key: 'ucsc', name: 'UCSC', x: 80, y: 160 },
  { year: '2021', key: 'dahua', name: 'DAHUA', x: 220, y: 120 },
  { year: '2022', key: 'alibaba', name: 'ALIBABA', x: 380, y: 80 },
  { year: '2025', key: 'xiaomi', name: 'XIAOMI', x: 560, y: 40, featured: true },
];
---
<section id="section-02" class="journey">
  <div class="journey-inner">
    <div class="section-label" data-i18n="journey.label">02 — 成长历程</div>

    <svg class="journey-svg" viewBox="0 0 660 220" aria-hidden="true">
      <!-- Connecting line -->
      <line
        class="journey-line"
        x1="80" y1="160"
        x2="560" y2="40"
        stroke="var(--gold)"
        stroke-width="1.5"
        opacity="0.5"
      />

      {nodes.map((n) => (
        <g class="journey-node" data-node={n.key}>
          <circle
            cx={n.x} cy={n.y}
            r={n.featured ? 8 : 5}
            fill={n.featured ? 'var(--gold)' : 'none'}
            stroke="var(--gold)"
            stroke-width="1.5"
          />
          {n.featured && (
            <circle cx={n.x} cy={n.y} r="14" fill="none" stroke="var(--gold)" stroke-width="0.5" opacity="0.3" />
          )}
          <text x={n.x} y={n.y - 18} text-anchor="middle"
            font-family="var(--font-display)" font-size="18" font-weight="700" fill="#f5f0e8">
            {n.year}
          </text>
          <text x={n.x} y={n.y + 22} text-anchor="middle"
            font-family="var(--font-mono)" font-size="9" letter-spacing="2" fill="var(--gold)">
            {n.name}
          </text>
        </g>
      ))}
    </svg>

    <div class="journey-descs">
      {nodes.map((n) => (
        <div class="journey-desc" data-node={n.key}>
          <span data-i18n={`journey.${n.key}.desc`}></span>
        </div>
      ))}
    </div>

    <div class="journey-ascending">ASCENDING ↗</div>
  </div>
</section>

<style>
.journey {
  background: var(--dark);
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 80px 40px;
}

.journey-inner {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
}

.journey-inner .section-label {
  color: var(--gray-2);
  margin-bottom: 60px;
}

.journey-svg {
  width: 100%;
  max-width: 700px;
  display: block;
  margin: 0 auto;
  overflow: visible;
}

.journey-descs {
  display: flex;
  justify-content: space-between;
  margin-top: 20px;
  padding: 0 20px;
}

.journey-desc {
  font-family: var(--font-body);
  font-size: 11px;
  color: var(--gray-2);
  text-align: center;
  max-width: 120px;
  line-height: 1.6;
}

.journey-ascending {
  text-align: right;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 3px;
  color: var(--gray-3);
  margin-top: 24px;
}

@media (max-width: 600px) {
  .journey-descs { flex-wrap: wrap; gap: 12px; justify-content: center; }
}
</style>
